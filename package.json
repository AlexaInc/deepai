{
  "name": "alexa-ai",
  "version": "2.1.0",
  "description": "Object-oriented DeepAI-powered AI engine for the Alexa WhatsApp bot: full DeepAI API surface, cross-chat identity linking (@lid <-> phone) and PostgreSQL-backed long-term memory.",
  "main": "index.js",
  "scripts": {
    "test": "node test/run-tests.js && node test/wrapper-methods.js",
    "demo": "node examples/demo.js",
    "migrate": "node -e \"require('./index').AlexaAI.migrate(process.env.POSTGRES_URL).then(()=>{console.log('migrated');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "test:wrapper": "node test/wrapper-methods.js"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "deepai",
    "postgres",
    "chatbot",
    "alexa",
    "memory",
    "lid",
    "vision"
  ],
  "author": "Hansaka",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "files": [
    "index.js",
    "src/",
    "examples/",
    "README.md"
  ]
}
